{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A job or project being tracked",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "offerPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["aktivní", "dokončeno", "pozastaveno", "smazáno"] },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "offerPrice", "status", "startDate", "ownerId"]
    },
    "CostItem": {
      "title": "Cost Item",
      "description": "An individual expense within a project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string", "enum": ["materiál", "práce", "subdodávky", "doprava", "režie", "ostatní"] },
        "date": { "type": "string", "format": "date" },
        "note": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "description", "amount", "category", "date", "ownerId"]
    },
    "Log": {
      "title": "Activity Log",
      "description": "A record of an action taken in the system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "targetId": { "type": "string" },
        "targetName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "string" }
      },
      "required": ["id", "type", "userId", "userName", "userEmail", "targetId", "targetName", "timestamp"]
    },
    "AppSettings": {
      "title": "App Settings",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "alertThreshold": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/settings/global": {
      "schema": "AppSettings",
      "description": "Global application settings"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Projects collection"
    },
    "/costs/{costId}": {
      "schema": "CostItem",
      "description": "Costs collection linked to projects"
    },
    "/logs/{logId}": {
      "schema": "Log",
      "description": "Activity logs collection"
    }
  }
}
